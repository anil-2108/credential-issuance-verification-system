        "unique": false,
        "rule": "> credential.issued_at"
      },
      {
        "name": "reason_code",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ISSUED_IN_ERROR",
          "ACADEMIC_MISCONDUCT",
          "LEARNER_REQUEST",
          "FRAUD",
          "POLICY_VIOLATION",
          "COURSE_RETIRED"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "revoked_by_actor_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK actors.actor_id",
        "unit": "-",
        "unique": false,
        "rule": "staff role by reason"
      }
    ]
