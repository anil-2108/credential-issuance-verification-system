        "rule": "PK; NN = revocation_seq"
      },
      {
        "name": "credential_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK credentials.credential_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "revocation_seq",
        "type": "INTEGER",
        "required": true,
        "allowed": "1..2",
        "unit": "-",
        "unique": false,
        "rule": "contiguous per credential"
      },
      {
        "name": "revoked_at",
        "type": "TIMESTAMP",
