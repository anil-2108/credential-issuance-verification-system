{
  "actors": {
    "entity": "Actor (supporting)",
    "file": "actors.csv",
    "primary_key": "actor_id",
    "fields": [
      {
        "name": "actor_id",
        "type": "STRING",
        "required": true,
        "allowed": "ACT-NNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK; zero-padded; ACT-0000 reserved for SYSTEM"
      },
      {
        "name": "display_name",
        "type": "STRING",
        "required": true,
        "allowed": "synthetic name",
        "unit": "-",
        "unique": false,
        "rule": "non-empty"
      },
      {
        "name": "role",
        "type": "STRING",
        "required": true,
        "allowed": [
          "SYSTEM",
          "INSTRUCTOR",
          "ACADEMIC_ADMIN",
          "SUPPORT_STAFF",
          "PLATFORM_ADMIN"
        ],
        "unit": "-",
        "unique": false,
        "rule": "one of ROLES"
      },
      {
        "name": "email",
        "type": "STRING",
        "required": true,
        "allowed": "@example.org",
        "unit": "-",
        "unique": true,
        "rule": "synthetic address on reserved domain"
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "INACTIVE"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      }
    ]
  },
  "issuers": {
    "entity": "Issuer",
    "file": "issuers.csv",
    "primary_key": "issuer_id",
    "fields": [
      {
        "name": "issuer_id",
        "type": "STRING",
        "required": true,
        "allowed": "ISS-NNN",
        "unit": "-",
        "unique": true,
        "rule": "PK"
      },
      {
        "name": "issuer_name",
        "type": "STRING",
        "required": true,
        "allowed": "text",
        "unit": "-",
        "unique": true,
        "rule": ""
      },
      {
        "name": "issuer_type",
        "type": "STRING",
        "required": true,
        "allowed": [
          "UNIVERSITY",
          "TRAINING_PROVIDER",
          "PROFESSIONAL_BODY"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "country",
        "type": "STRING",
        "required": true,
        "allowed": "ISO 3166-1 alpha-2",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "SUPERSEDED"
        ],
        "unit": "-",
        "unique": false,
        "rule": "SUPERSEDED iff effective_to is set"
      },
      {
        "name": "effective_from",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "<= effective_to"
      },
      {
        "name": "effective_to",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "set when issuer is superseded"
      },
      {
        "name": "predecessor_issuer_id",
        "type": "STRING",
        "required": false,
        "allowed": "FK issuers.issuer_id",
        "unit": "-",
        "unique": false,
        "rule": "issuer change lineage"
      },
      {
        "name": "signing_key_id",
        "type": "STRING",
        "required": true,
        "allowed": "<issuer_id>-K1",
        "unit": "-",
        "unique": true,
        "rule": "key used to sign credentials"
      },
      {
        "name": "key_fingerprint",
        "type": "STRING",
        "required": true,
        "allowed": "16 hex",
        "unit": "-",
        "unique": true,
        "rule": "sha256(key)[:16]; demo key, derived from seed"
      }
    ]
  },
  "learners": {
    "entity": "Learner",
    "file": "learners.csv",
    "primary_key": "learner_id",
    "fields": [
      {
        "name": "learner_id",
        "type": "STRING",
        "required": true,
        "allowed": "LRN-NNNNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK; immutable"
      },
      {
        "name": "first_name",
        "type": "STRING",
        "required": true,
        "allowed": "synthetic",
        "unit": "-",
        "unique": false,
        "rule": "duplicates allowed"
      },
      {
        "name": "last_name",
        "type": "STRING",
        "required": true,
        "allowed": "synthetic",
        "unit": "-",
        "unique": false,
        "rule": "duplicates allowed"
      },
      {
        "name": "full_name",
        "type": "STRING",
        "required": true,
        "allowed": "first + ' ' + last",
        "unit": "-",
        "unique": false,
        "rule": "NOT unique, NOT an identity key"
      },
      {
        "name": "email",
        "type": "STRING",
        "required": true,
        "allowed": "@example.org",
        "unit": "-",
        "unique": true,
        "rule": "lower-case; identity attribute"
      },
      {
        "name": "date_of_birth",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "learner >= 18 on created_at; identity attribute"
      },
      {
        "name": "country",
        "type": "STRING",
        "required": true,
        "allowed": "ISO 3166-1 alpha-2",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "SUSPENDED",
          "CLOSED"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "created_at",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "<= first enrolled_at"
      }
    ]
  },
  "courses": {
    "entity": "Course",
    "file": "courses.csv",
    "primary_key": "course_id",
    "fields": [
      {
        "name": "course_id",
        "type": "STRING",
        "required": true,
        "allowed": "CRS-NNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK"
      },
      {
        "name": "title",
        "type": "STRING",
        "required": true,
        "allowed": "text",
        "unit": "-",
        "unique": false,
        "rule": "titles repeat across issuers"
      },
      {
        "name": "category",
        "type": "STRING",
        "required": true,
        "allowed": "text",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "level",
        "type": "STRING",
        "required": true,
        "allowed": [
          "BEGINNER",
          "INTERMEDIATE",
          "ADVANCED"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "credit_hours",
        "type": "INTEGER",
        "required": true,
        "allowed": "8..120",
        "unit": "hours",
        "unique": false,
        "rule": ""
      },
      {
        "name": "duration_days",
        "type": "INTEGER",
        "required": true,
        "allowed": ">= 14",
        "unit": "days",
        "unique": false,
        "rule": "= 14 + 0.8 * credit_hours"
      },
      {
        "name": "num_assessments",
        "type": "INTEGER",
        "required": true,
        "allowed": "3..5",
        "unit": "count",
        "unique": false,
        "rule": "= rule.min_assessments"
      },
      {
        "name": "instructor_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK actors.actor_id (role INSTRUCTOR)",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "issuer_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK issuers.issuer_id",
        "unit": "-",
        "unique": false,
        "rule": "CURRENT issuer = last course_issuer_history row"
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "RETIRED"
        ],
        "unit": "-",
        "unique": false,
        "rule": "RETIRED iff effective_to set"
      },
      {
        "name": "effective_from",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "<= effective_to"
      },
      {
        "name": "effective_to",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": ""
      }
    ]
  },
  "course_issuer_history": {
    "entity": "Course-Issuer bridge (N:M over time)",
    "file": "course_issuer_history.csv",
    "primary_key": "history_id",
    "fields": [
      {
        "name": "history_id",
        "type": "STRING",
        "required": true,
        "allowed": "CIH-NNNNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK"
      },
      {
        "name": "course_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK courses.course_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "issuer_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK issuers.issuer_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "effective_from",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "periods per course do not overlap"
      },
      {
        "name": "effective_to",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "NULL = current"
      },
      {
        "name": "change_reason",
        "type": "STRING",
        "required": true,
        "allowed": [
          "INITIAL",
          "ISSUER_SUCCESSION",
          "ISSUER_TRANSFER"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      }
    ]
  },
  "credential_rules": {
    "entity": "CredentialRule",
    "file": "credential_rules.csv",
    "primary_key": "rule_id",
    "fields": [
      {
        "name": "rule_id",
        "type": "STRING",
        "required": true,
        "allowed": "RUL-NNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK"
      },
      {
        "name": "course_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK courses.course_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "rule_version",
        "type": "INTEGER",
        "required": true,
        "allowed": "1..2",
        "unit": "-",
        "unique": false,
        "rule": "(course_id, rule_version) unique"
      },
      {
        "name": "min_progress_pct",
        "type": "INTEGER",
        "required": true,
        "allowed": "100",
        "unit": "%",
        "unique": false,
        "rule": ""
      },
      {
        "name": "min_assessments",
        "type": "INTEGER",
        "required": true,
        "allowed": "3..5",
        "unit": "count",
        "unique": false,
        "rule": ""
      },
      {
        "name": "min_final_score",
        "type": "INTEGER",
        "required": true,
        "allowed": "60..85",
        "unit": "points of 100",
        "unique": false,
        "rule": "inclusive threshold (>=)"
      },
      {
        "name": "min_attendance_pct",
        "type": "INTEGER",
        "required": true,
        "allowed": [
          0,
          70,
          80
        ],
        "unit": "%",
        "unique": false,
        "rule": "0 = no attendance requirement"
      },
      {
        "name": "validity_months",
        "type": "INTEGER",
        "required": false,
        "allowed": [
          6,
          12,
          24,
          36,
          60
        ],
        "unit": "months",
        "unique": false,
        "rule": "NULL = never expires"
      },
      {
        "name": "effective_from",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "rule applies to enrollments on/after"
      },
      {
        "name": "effective_to",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": ""
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "SUPERSEDED",
          "RETIRED"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      }
    ]
  },
  "completion_records": {
    "entity": "CompletionRecord (Learner-Course bridge)",
    "file": "completion_records.csv",
    "primary_key": "completion_id",
    "fields": [
      {
        "name": "completion_id",
        "type": "STRING",
        "required": true,
        "allowed": "CMP-<learner-id>-<course-id>",
        "unit": "-",
        "unique": true,
        "rule": "PK; (learner,course) unique"
      },
      {
        "name": "learner_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK learners.learner_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "course_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK courses.course_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "rule_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK credential_rules.rule_id",
        "unit": "-",
        "unique": false,
        "rule": "rule in force at enrolled_at"
      },
      {
        "name": "enrolled_at",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": ">= learner.created_at"
      },
      {
        "name": "closed_at",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "set for COMPLETED/FAILED/WITHDRAWN"
      },
      {
        "name": "completed_at",
        "type": "DATE",
        "required": false,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "set only when COMPLETED (= closed_at)"
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "IN_PROGRESS",
          "COMPLETED",
          "FAILED",
          "WITHDRAWN"
        ],
        "unit": "-",
        "unique": false,
        "rule": "COMPLETED iff coursework finished AND rule met"
      },
      {
        "name": "progress_pct",
        "type": "INTEGER",
        "required": true,
        "allowed": "0..100",
        "unit": "%",
        "unique": false,
        "rule": ""
      },
      {
        "name": "assessments_taken",
        "type": "INTEGER",
        "required": true,
        "allowed": ">= 0",
        "unit": "count",
        "unique": false,
        "rule": "= count(assessments rows)"
      },
      {
        "name": "final_score",
        "type": "DECIMAL",
        "required": false,
        "allowed": "0..100",
        "unit": "points",
        "unique": false,
        "rule": "= round(mean(assessment.score), 2)"
      },
      {
        "name": "attendance_pct",
        "type": "DECIMAL",
        "required": true,
        "allowed": "0..100",
        "unit": "%",
        "unique": false,
        "rule": ""
      },
      {
        "name": "requirements_met",
        "type": "BOOLEAN",
        "required": true,
        "allowed": [
          0,
          1
        ],
        "unit": "-",
        "unique": false,
        "rule": "derived: evaluate_rule(rule, ...)"
      },
      {
        "name": "failure_reasons",
        "type": "STRING",
        "required": false,
        "allowed": "PROGRESS_BELOW_MIN|ASSESSMENTS_MISSING|SCORE_BELOW_MIN|ATTENDANCE_BELOW_MIN",
        "unit": "-",
        "unique": false,
        "rule": "pipe-separated; set only for FAILED"
      }
    ]
  },
  "assessments": {
    "entity": "Assessment (supporting)",
    "file": "assessments.csv",
    "primary_key": "assessment_id",
    "fields": [
      {
        "name": "assessment_id",
        "type": "STRING",
        "required": true,
        "allowed": "AST-NNNNNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK"
      },
      {
        "name": "completion_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK completion_records.completion_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "sequence_no",
        "type": "INTEGER",
        "required": true,
        "allowed": "1..5",
        "unit": "-",
        "unique": false,
        "rule": "(completion_id, sequence_no) unique"
      },
      {
        "name": "assessment_type",
        "type": "STRING",
        "required": true,
        "allowed": [
          "QUIZ",
          "PROJECT",
          "FINAL_EXAM"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "score",
        "type": "INTEGER",
        "required": true,
        "allowed": "0..100",
        "unit": "points",
        "unique": false,
        "rule": ""
      },
      {
        "name": "max_score",
        "type": "INTEGER",
        "required": true,
        "allowed": [
          100
        ],
        "unit": "points",
        "unique": false,
        "rule": ""
      },
      {
        "name": "taken_at",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "within enrolment window"
      }
    ]
  },
  "credentials": {
    "entity": "Credential",
    "file": "credentials.csv",
    "primary_key": "credential_id",
    "fields": [
      {
        "name": "credential_id",
        "type": "STRING",
        "required": true,
        "allowed": "CRD-YYYY-NNNNNN",
        "unit": "-",
        "unique": true,
        "rule": "PK (logical). Injected DUPLICATE_CREDENTIAL_ID rows violate this on purpose"
      },
      {
        "name": "completion_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK completion_records.completion_id",
        "unit": "-",
        "unique": true,
        "rule": "1 completion -> at most 1 credential"
      },
      {
        "name": "learner_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK learners.learner_id",
        "unit": "-",
        "unique": false,
        "rule": "= completion.learner_id"
      },
      {
        "name": "course_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK courses.course_id",
        "unit": "-",
        "unique": false,
        "rule": "= completion.course_id"
      },
      {
        "name": "rule_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK credential_rules.rule_id",
        "unit": "-",
        "unique": false,
        "rule": "= completion.rule_id"
      },
      {
        "name": "issuer_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK issuers.issuer_id",
        "unit": "-",
        "unique": false,
        "rule": "issuer of the course ON issued_at date"
      },
      {
        "name": "issued_at",
        "type": "TIMESTAMP",
        "required": true,
        "allowed": "UTC, ISO-8601 YYYY-MM-DDTHH:MM:SSZ",
        "unit": "UTC",
        "unique": false,
        "rule": ">= completion.completed_at (anomaly otherwise)"
      },
      {
        "name": "expires_at",
        "type": "TIMESTAMP",
        "required": false,
        "allowed": "UTC, ISO-8601 YYYY-MM-DDTHH:MM:SSZ",
        "unit": "UTC",
        "unique": false,
        "rule": "= issued_at + rule.validity_months"
      },
      {
        "name": "status",
        "type": "STRING",
        "required": true,
        "allowed": [
          "ACTIVE",
          "REVOKED",
          "EXPIRED"
        ],
        "unit": "-",
        "unique": false,
        "rule": "snapshot at status_as_of, derived by replaying audit events"
      },
      {
        "name": "status_as_of",
        "type": "DATE",
        "required": true,
        "allowed": "ISO-8601 YYYY-MM-DD",
        "unit": "date",
        "unique": false,
        "rule": "dataset as-of date"
      },
      {
        "name": "payload_json",
        "type": "JSON",
        "required": true,
        "allowed": "canonical JSON",
        "unit": "-",
        "unique": false,
        "rule": "the signed payload"
      },
      {
        "name": "payload_hash",
        "type": "STRING",
        "required": true,
        "allowed": "64 hex",
        "unit": "-",
        "unique": false,
        "rule": "SHA-256(payload_json)"
      },
      {
        "name": "hash_algo",
        "type": "STRING",
        "required": true,
        "allowed": [
          "SHA-256"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "signature",
        "type": "STRING",
        "required": true,
        "allowed": "64 hex",
        "unit": "-",
        "unique": false,
        "rule": "HMAC-SHA256(issuer key, payload_hash)"
      },
      {
        "name": "signature_alg",
        "type": "STRING",
        "required": true,
        "allowed": [
          "HMAC-SHA256"
        ],
        "unit": "-",
        "unique": false,
        "rule": ""
      },
      {
        "name": "signing_key_id",
        "type": "STRING",
        "required": true,
        "allowed": "FK issuers.signing_key_id",
        "unit": "-",
        "unique": false,
        "rule": ""
      }
    ]
  },
  "revocations": {
    "entity": "Revocation",
    "file": "revocations.csv",
    "primary_key": "revocation_id",
    "fields": [
      {
        "name": "revocation_id",
        "type": "STRING",
